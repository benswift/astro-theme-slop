{
  "name": "astro-theme-slop",
  "version": "0.1.0",
  "description": "Slop University branding data for astro-theme-university — brand palette CSS, lockup/crest SVG assets, and a slopBranding props object.",
  "keywords": [
    "astro-component",
    "branding",
    "slop-university",
    "theme"
  ],
  "homepage": "https://github.com/benswift/astro-theme-slop",
  "bugs": {
    "url": "https://github.com/benswift/astro-theme-slop/issues"
  },
  "license": "MIT",
  "author": "Ben Swift <ben@benswift.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benswift/astro-theme-slop.git"
  },
  "files": [
    "CHANGELOG.md",
    "index.ts",
    "types-shim.d.ts",
    "slop.css",
    "assets/"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./slop.css": "./slop.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && pnpm lint:css",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "lint:css": "stylelint --allow-empty-input \"*.css\"",
    "lint:css:fix": "stylelint --allow-empty-input --fix \"*.css\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.5.1",
    "@types/node": "^26.1.1",
    "astro": "^7.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
